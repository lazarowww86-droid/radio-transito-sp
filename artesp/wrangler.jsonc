{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radio-transito-sp-artesp",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ARTESP_CACHE", "class_name": "ArtespStore" }]
  },
  "exports": { "ArtespStore": { "type": "durable-object", "storage": "sqlite" } },
  "vars": {
    "RADIO_ORIGIN": "https://lazarowww86-droid.github.io",
    "ARTESP_MUNICIPIOS": "3550308,3518800",
    "ARTESP_REGIAO": "São Paulo e Guarulhos"
  }
}
